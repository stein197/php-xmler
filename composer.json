{
    "name": "stein197/xmler",
    "description": "XML and HTML builder",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Stein197\\Xmler\\": "src/"
        },
        "files": [
            "./src/index.php"
        ]
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "test": "pest --test-directory test",
        "analyse": "phpstan analyse --level 10 src"
    },
    "scripts-descriptions": {
        "test": "Run Pest tests",
        "analyse": "Run PHPStan analyser"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
